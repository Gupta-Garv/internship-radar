# Full-Hybrid $0 X Intelligence Radar Secrets
# Copy this file to .env for local runs, or add these exact names to GitHub Repo -> Settings -> Secrets and variables -> Actions

# 1. Burner X Account Cookies (grab from Chrome DevTools -> Application -> Cookies -> https://x.com)
# NEVER use your main X account! Use a free email-only burner account.
X_AUTH_TOKEN=
X_CT0=
X_BURNER_USERNAME=burner_1

# Optional: Multiple burner accounts for rotation (JSON array):
# X_BURNER_ACCOUNTS=[{"username":"burner1","auth_token":"...","ct0":"..."},{"username":"burner2","auth_token":"...","ct0":"..."}]

# 2. Exa.ai Free Tier ($10/month free credits, no credit card -> https://dashboard.exa.ai)
EXA_API_KEY=

# 3. Optional: Free Telegram Bot Push Alerts (get token from @BotFather, chat_id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. NVIDIA NIM API Key (optional override; uses your existing configured key by default)
NVIDIA_API_KEY=
